{
  "expo": {
    "name": "Mediapp", "slug": "mediapp", "scheme": "mediapp", "version": "1.0.0", "orientation": "default", "userInterfaceStyle": "light", "icon": "./assets/icon.png",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.amansingh.mediapp", "infoPlist": { "CADisableMinimumFrameDurationOnPhone": true } },
    "android": { "package": "com.amansingh.mediapp", "adaptiveIcon": { "foregroundImage": "./assets/android-icon-foreground.png", "backgroundColor": "#F8F7F3" }, "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"] },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router", "expo-font", "expo-secure-store", "expo-localization", ["expo-splash-screen", { "backgroundColor": "#F8F7F3", "image": "./assets/splash-icon.png", "imageWidth": 160 }], ["expo-image-picker", { "photosPermission": "Choose a prescription photo.", "cameraPermission": "Take a photo of your prescription." }], ["expo-notifications", { "color": "#334D92" }], ["expo-location", { "locationWhenInUsePermission": "Find hospitals near you." }], "@react-native-community/datetimepicker"],
    "experiments": { "typedRoutes": true }
  }
}
