# ==========================================
# MediScan Local Workspace .gitignore
# ==========================================

# AI Datasets & Models
ai/
**/ai/

# Dependencies
node_modules/
**/node_modules/

# Python Virtual Environments & Bytecode
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
.pytest_cache/
**/.pytest_cache/
*.py[cod]
*$py.class

# Environment Variables & Secrets
.env
**/.env
.env.*
!.env.example
*.env.local

# Expo & Web Bundles
.expo/
**/.expo/
dist/
**/dist/
web-build/
**/web-build/

# Native Mobile Folders
android/
ios/
mobile/android/
mobile/ios/

# Databases & Cache
*.db
*.sqlite
*.sqlite3
.cache/
**/.cache/
uploads/
**/uploads/

# Test Reports
test-results/
playwright-report/

# OS Artifacts
.DS_Store
**/.DS_Store
Thumbs.db
